{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kho-anh",
  "account_id": "a9fe540e1b92c1a726089f3da01fa189",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kho-anh-db",
      "database_id": "466ad7c0-1fb0-4674-a629-ca4530d7a3e0",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "VAULT_BUCKET", "bucket_name": "kho-anh-vault" }]
}
