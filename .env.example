# ============================================
# Secure Media Backup - Environment Config
# ============================================

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database:
# - Local zero-setup (embedded PostgreSQL via PGlite): pglite://./data/pgdata
# - Cloud Free (Neon PostgreSQL) or Docker Postgres:   postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=pglite://./data/pgdata

# Security Secrets (CHANGE IN PRODUCTION! Minimum 32 random chars)
JWT_ACCESS_SECRET=change-me-dev-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Master key for encrypting Cloud S3 Secret Access Keys stored in PostgreSQL (32+ random chars)
STORAGE_CONFIG_KEY=change-me-dev-storage-config-key-32-chars-long

# Storage Primary Adapter: local | s3
STORAGE_PRIMARY_TYPE=local
STORAGE_LOCAL_ROOT=./data/storage

# Optional S3-compatible targets (Cloudflare R2 / Backblaze B2 / Oracle Cloud / MinIO)
# Copy 1 (Primary - e.g. Cloudflare R2)
S3_PRIMARY_ENDPOINT=
S3_PRIMARY_REGION=auto
S3_PRIMARY_BUCKET=
S3_PRIMARY_ACCESS_KEY_ID=
S3_PRIMARY_SECRET_ACCESS_KEY=
S3_PRIMARY_FORCE_PATH_STYLE=true

# Copy 2 (Secondary - e.g. Backblaze B2)
S3_SECONDARY_ENDPOINT=
S3_SECONDARY_REGION=us-west-004
S3_SECONDARY_BUCKET=
S3_SECONDARY_ACCESS_KEY_ID=
S3_SECONDARY_SECRET_ACCESS_KEY=
S3_SECONDARY_FORCE_PATH_STYLE=true

# Copy 3 (Offsite - e.g. Oracle Cloud Object Storage / Home NAS MinIO)
S3_OFFSITE_ENDPOINT=
S3_OFFSITE_REGION=ap-singapore-1
S3_OFFSITE_BUCKET=
S3_OFFSITE_ACCESS_KEY_ID=
S3_OFFSITE_SECRET_ACCESS_KEY=
S3_OFFSITE_FORCE_PATH_STYLE=true

# Default per-user quota in bytes (default 100 GiB; adjust as needed)
DEFAULT_USER_QUOTA_BYTES=107374182400
